# Copy to .env only when the selected implementation actually needs these.
# Never place server/service-role secrets in a mobile application.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional provider configuration; keep disabled in mock-first phases.
EXPO_PUBLIC_AI_PROVIDER_MODE=mock
EXPO_PUBLIC_LOCAL_BUSINESS_PROVIDER_MODE=mock
